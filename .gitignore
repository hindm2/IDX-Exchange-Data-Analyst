# -*- coding: utf-8 -*-
"""Weeks 2–3: Dataset structuring, validation and numeric EDA.

Source notebook:
https://colab.research.google.com/drive/1oXvtORB-kGyvdMYiCl5CcGFeDi1t-vtY

Input: /content/week1_combined_output.zip (two Week 1 Residential CSVs).
Run in Colab as a cell or with %run. Locally, put the ZIP beside this script.
Displays structure, null-count tables, field categories, column decisions,
numeric summaries, histograms, boxplots, correlation and extreme values.
Saves two analysis CSVs to weeks2_3_updated_output. Core fields are protected;
non-core columns above 90% null are dropped from analysis copies only.
No row deduplication, numeric outlier removal or imputation is performed.
No mortgage enrichment is performed. Input ZIP remains unchanged.
"""
from pathlib import Path
import tempfile
import zipfile
import pandas as pd
from IPython.display import display

BASE = Path('/content') if Path('/content').is_dir() else Path(__file__).resolve().parent
zip_path = BASE / 'week1_combined_output.zip'
output_folder = BASE / 'weeks2_3_updated_output'
expected = {
    'listings': ('CRMLS_listings_Residential_202401_202609.csv', 658117),
    'sold': ('CRMLS_sold_Residential_202401_202609.csv', 495291),
}


def main():
    if not zip_path.is_file():
        raise FileNotFoundError(f'Upload the Week 1 output ZIP: {zip_path}')
    data_folder = Path(tempfile.mkdtemp(prefix='week2_inputs_', dir=BASE))
    with zipfile.ZipFile(zip_path) as archive:
        damaged = archive.testzip()
        if damaged:
            raise ValueError(f'Damaged ZIP member: {damaged}')
        archive.extractall(data_folder)
    inputs = {}
    for label, (filename, _) in expected.items():
        matches = [p for p in data_folder.rglob(filename) if '__MACOSX' not in p.parts]
        if len(matches) != 1:
            raise ValueError(f'Expected one {filename}; found {len(matches)}')
        inputs[label] = matches[0]
    output_folder.mkdir(parents=True, exist_ok=True)
    for label, path in inputs.items():
        frame = pd.read_csv(path, low_memory=False)
        if len(frame) != expected[label][1]:
            raise ValueError(f'{label}: expected {expected[label][1]:,} rows, found {len(frame):,}')
        print(f'\n{label.upper()} — VALIDATION OF WEEK 1 RESIDENTIAL DATA')
        print('Property types found:', frame['PropertyType'].unique())
        print(f'Residential records loaded from Week 1: {len(frame):,}')
        df = frame.loc[frame['PropertyType'].eq('Residential')].copy()
        print(f'Additional non-Residential records removed: {len(frame)-len(df):,}')
        print('Original property-type shares require raw monthly data; these inputs are already filtered.')
        if label == 'sold' and 'CloseDate' in df:
            dates = pd.to_datetime(df['CloseDate'], errors='coerce', utc=True)
            print('Earliest sale:', dates.min())
            print('Latest sale:', dates.max())
            print('Missing or unparseable CloseDate:', dates.isna().sum())
        analyze(df, label)
        del frame, df


def analyze(df, label):
    # 1. Number of rows and columns
    print(f"Rows: {df.shape[0]:,}")
    print(f"Columns: {df.shape[1]}")

    # 2. Data types and missing values
    column_summary = pd.DataFrame({
        "Data_type": df.dtypes.astype(str),
        "Missing_count": df.isna().sum(),
        "Missing_percent": df.isna().mean() * 100
    }).sort_values("Missing_percent", ascending=False)

    display(column_summary.round({"Missing_percent": 2}))

    # 3. Flag columns with more than 90% missing values
    high_missing = column_summary[
        column_summary["Missing_percent"] > 90
    ]

    print(f"\nColumns above 90% missing: {len(high_missing)}")
    display(high_missing.round({"Missing_percent": 2}))

    #separating market analysis fields from metadata

    market_candidates = [
        "ClosePrice", "ListPrice", "OriginalListPrice",
        "CloseDate", "ListingContractDate", "PurchaseContractDate",
        "DaysOnMarket", "MlsStatus",
        "PropertyType", "PropertySubType",
        "LivingArea", "LotSizeSquareFeet", "LotSizeAcres",
        "BedroomsTotal", "BathroomsTotalInteger", "YearBuilt",
        "City", "CountyOrParish", "StateOrProvince", "PostalCode",
        "Latitude", "Longitude", "MLSAreaMajor",
        "GarageSpaces", "ParkingTotal", "Stories",
        "PoolPrivateYN", "NewConstructionYN",
        "AssociationFee", "AssociationFeeFrequency"
    ]

    metadata_candidates = [
        "ListingKey", "ListingKeyNumeric", "ListingId",
        "OriginatingSystemName", "OriginatingSystemSubName"
    ]

    def classify_column(column):
        if column in market_candidates:
            return "Market analysis"
        if (
            column in metadata_candidates
            or "Agent" in column
            or "Office" in column
        ):
            return "Metadata"
        return "Other — review"

    field_review = column_summary.copy()
    field_review["Category"] = [
        classify_column(column) for column in field_review.index
    ]

    display(field_review.sort_values(["Category", "Missing_percent"]))

    print("\nColumns in each category:")
    print(field_review["Category"].value_counts())

    # Keep essential analysis fields even if partially missing
    core_fields = [
        "ClosePrice", "ListPrice", "OriginalListPrice",
        "CloseDate", "ListingContractDate", "DaysOnMarket",
        "PropertyType", "PropertySubType",
        "LivingArea", "BedroomsTotal", "BathroomsTotalInteger",
        "LotSizeSquareFeet", "YearBuilt",
        "City", "CountyOrParish", "StateOrProvince", "PostalCode",
        "Latitude", "Longitude",
        "ListingKey", "ListingId", "PurchaseContractDate",
        "ContractStatusChangeDate", "LotSizeAcres"
    ]

    # Recalculate using exact percentages before applying the threshold
    missing_review = pd.DataFrame({
        "Missing_count": df.isna().sum(),
        "Missing_percent": df.isna().mean() * 100
    })

    missing_review["Above_90_percent"] = (
        missing_review["Missing_percent"] > 90
    )

    def decide_column(column):
        percent = missing_review.loc[column, "Missing_percent"]

        if column in core_fields:
            return "Retain — core field"
        if percent > 90:
            return "Drop from analysis — very low coverage"
        return "Retain — review usefulness later"

    missing_review["Decision"] = [
        decide_column(column) for column in missing_review.index
    ]

    display(
        missing_review.sort_values(
            "Missing_percent", ascending=False
        ).round({"Missing_percent": 2})
    )

    # Create a separate analysis dataset; preserve the original df
    drop_columns = missing_review.index[
        missing_review["Decision"] ==
        "Drop from analysis — very low coverage"
    ].tolist()

    df_analysis = df.drop(columns=drop_columns).copy()

    print("Columns dropped:", len(drop_columns))
    print(drop_columns)
    print("Analysis dataset shape:", df_analysis.shape)

    import numpy as np
    import pandas as pd

    numeric_fields = [
        "ClosePrice", "ListPrice", "OriginalListPrice",
        "LivingArea", "LotSizeAcres", "BedroomsTotal",
        "BathroomsTotalInteger", "DaysOnMarket", "YearBuilt"
    ]

    # Use only fields present in the analysis dataset.
    missing_fields = [
        field for field in numeric_fields
        if field not in df_analysis.columns
    ]
    print("Numeric fields not available:", missing_fields or "None")

    numeric_fields = [
        field for field in numeric_fields
        if field in df_analysis.columns
    ]

    # Prepare numeric values for summaries and plots.
    numeric_data = (
        df_analysis[numeric_fields]
        .apply(pd.to_numeric, errors="coerce")
        .replace([np.inf, -np.inf], np.nan)
    )

    print("Numeric data ready:", numeric_data.shape)

    summary = numeric_data.describe(
        percentiles=[.01, .05, .25, .50, .75, .95, .99]
    ).T.rename(columns={"50%": "Median"})
    display(summary.round(2))


    import matplotlib.pyplot as plt
    from matplotlib.ticker import FuncFormatter

    for field in numeric_fields:
        values = numeric_data[field].dropna()

        if values.empty:
            continue

        # Histogram: display the middle 98% of values
        lower = values.quantile(0.01)
        upper = values.quantile(0.99)
        histogram_values = values[values.between(lower, upper)]

        fig, axes = plt.subplots(1, 2, figsize=(12, 4))

        axes[0].hist(
            histogram_values,
            bins=40,
            edgecolor="black"
        )
        axes[0].set_title(f"{field} — 1st–99th percentiles")
        axes[0].set_xlabel(field)
        axes[0].set_ylabel("Number of records")

        # Boxplot: calculate quartiles using all non-missing values
        axes[1].boxplot(values, vert=False, whis=3)
        axes[1].set_title(f"{field} — full-data boxplot")
        axes[1].set_xlabel(field)
        axes[1].set_yticks([])

        # Zoom the ClosePrice boxplot for readability
        if field == "ClosePrice":
            axes[1].set_xlim(0, 4_000_000)
            axes[1].xaxis.set_major_formatter(
                FuncFormatter(
                    lambda value, position: f"${value / 1_000_000:.1f}M"
                )
            )
            axes[1].set_title("ClosePrice — zoomed view")
            axes[1].set_xlabel(
                "Sale price (values above $4 million are outside the view)"
            )

        plt.tight_layout()
        plt.show()
        plt.close(fig)

    import seaborn as sns
    import matplotlib.pyplot as plt

    correlation = numeric_data.corr(method="spearman")

    plt.figure(figsize=(11, 8))

    sns.heatmap(
        correlation,
        annot=True,
        fmt=".2f",
        cmap="coolwarm",
        vmin=-1,
        vmax=1,
        center=0
    )

    plt.title("Spearman Correlation Between Numeric Fields")
    plt.xticks(rotation=45, ha="right")
    plt.yticks(rotation=0)
    plt.tight_layout()
    plt.show()

    for column in numeric_fields:
        print(f"\n{column} — five lowest and highest values")

        display(pd.DataFrame({
            "Lowest": numeric_data[column].nsmallest(5).to_numpy(),
            "Highest": numeric_data[column].nlargest(5).to_numpy()
        }))

    if label == "sold":
        print("SALE PRICE COMPARED WITH LIST PRICE")
        cp = pd.to_numeric(df["ClosePrice"], errors="coerce").replace([np.inf, -np.inf], np.nan)
        lp = pd.to_numeric(df["ListPrice"], errors="coerce").replace([np.inf, -np.inf], np.nan)
        valid_prices = cp.gt(0) & lp.gt(0)
        n = int(valid_prices.sum())
        print(f"Median / mean close price (finite values): {cp.median():,.2f} / {cp.mean():,.2f}")
        print(f"List-price comparison denominator: {n:,}")
        for outcome, mask in [("Above", cp > lp), ("At", cp == lp), ("Below", cp < lp)]:
            count = int((valid_prices & mask).sum())
            print(f"{outcome} list: {count:,} ({count/n*100:.2f}%)" if n else f"{outcome} list: unavailable")
        print("Date issue counts can overlap. County counts are records, not deduplicated properties.")

        # 1. Date consistency
        print("DATE CONSISTENCY")

        pairs = [
            ("ListingContractDate", "CloseDate"),
            ("PurchaseContractDate", "CloseDate"),
            ("ListingContractDate", "PurchaseContractDate")
        ]

        for earlier, later in pairs:
            a = pd.to_datetime(df[earlier], errors="coerce", utc=True)
            b = pd.to_datetime(df[later], errors="coerce", utc=True)
            comparable = a.notna() & b.notna()

            print(
                f"{earlier} after {later}: "
                f"{int((comparable & (a > b)).sum()):,} records "
                f"out of {int(comparable.sum()):,} comparable records"
            )

        # 2. DaysOnMarket distribution
        print("\nDAYS ON MARKET DISTRIBUTION")

        dom = pd.to_numeric(df["DaysOnMarket"], errors="coerce")
        dom = dom.replace([np.inf, -np.inf], np.nan)

        masks = {
            "Negative": dom < 0, "0": dom == 0,
            "1–7": (dom > 0) & (dom <= 7),
            "8–30": (dom > 7) & (dom <= 30),
            "31–60": (dom > 30) & (dom <= 60),
            "61–90": (dom > 60) & (dom <= 90),
            "91–180": (dom > 90) & (dom <= 180), "Over 180": dom > 180
        }
        dom_table = pd.DataFrame({"Records": {k: int(v.sum()) for k, v in masks.items()}})
        dom_table["Percent"] = dom_table["Records"] / dom.notna().sum() * 100 if dom.notna().any() else float("nan")
        print(dom_table.round(2).to_string())
        print("Missing or nonnumeric DOM:", int(dom.isna().sum()))

        # 3. Counties with highest median close prices
        print("\nTOP COUNTIES BY MEDIAN CLOSE PRICE")

        prices = pd.to_numeric(df["ClosePrice"], errors="coerce")
        valid = prices.gt(0) & prices.lt(np.inf)

        county_summary = (
            df.loc[valid, ["CountyOrParish"]]
            .assign(ClosePrice=prices.loc[valid])
            .groupby("CountyOrParish")["ClosePrice"]
            .agg(Sales="count", MedianClosePrice="median")
        )

        top_counties = (
            county_summary[county_summary["Sales"] >= 200]
            .sort_values("MedianClosePrice", ascending=False)
            .head(10)
        )

        print(top_counties.round(2).to_string())

    output_path = output_folder / f'CRMLS_{label}_Residential_analysis_202401_202609.csv'
    df_analysis.to_csv(output_path, index=False)
    print(f'Saved: {output_path}')
    print(f'Final analysis rows: {len(df_analysis):,}; columns: {df_analysis.shape[1]}')
    print('No outlier rows removed. Histogram trimming and axis zoom affect display only.')


if __name__ == '__main__':
    main()
