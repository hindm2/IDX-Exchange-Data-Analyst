        "Dataset": name,
        "Rows before": rows_before,
        "Exact duplicates removed": rows_before - len(df),
        "Final rows": len(df)
    })

    if name == "Sold":
        sold = df
    else:
        listings = df

display(pd.DataFrame(final_duplicate_summary))

duplicate_removal_summary = pd.DataFrame(final_duplicate_summary)

final_duplicate_summary = []

for name, df in [("Sold", sold), ("Listings", listings)]:
