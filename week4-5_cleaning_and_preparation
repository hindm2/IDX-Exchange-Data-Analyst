state_check_summary = []

for name, df in [("Sold", sold), ("Listings", listings)]:
    state = (
        df["StateOrProvince"]
        .astype("string")
        .str.strip()
        .str.upper()
        .replace("", pd.NA)
    )

    df["StateOrProvince"] = state

    df["state_missing_flag"] = state.isna()

    # Missing states are tracked separately.
    df["state_outside_ca_flag"] = (
        state.notna()
        & ~state.isin(["CA", "CALIFORNIA"])
    )

    state_check_summary.append({
        "Dataset": name,
        "Missing state": int(df["state_missing_flag"].sum()),
        "State outside CA": int(df["state_outside_ca_flag"].sum())
    })

    print(f"\n{name}: State values")
    print(state.value_counts(dropna=False).to_string())

display(pd.DataFrame(state_check_summary))

"""Standardized text and whole-number fields"""

text_cleanup_summary = []

for name, df in [("Sold", sold), ("Listings", listings)]:
    text_columns = df.select_dtypes(
        include=["object", "string"]
    ).columns

    for column in text_columns:
        original = df[column].astype("string")
        cleaned = original.str.strip()

        spaces_removed = (
            original.ne(cleaned).fillna(False).sum()
        )

        blanks_to_missing = cleaned.eq("").fillna(False).sum()

        df[column] = cleaned.replace("", pd.NA)

        if spaces_removed or blanks_to_missing:
            text_cleanup_summary.append({
                "Dataset": name,
                "Column": column,
                "Values trimmed": int(spaces_removed),
                "Blanks made missing": int(blanks_to_missing)
            })

text_cleanup_summary = pd.DataFrame(
    text_cleanup_summary,
    columns=[
        "Dataset", "Column",
        "Values trimmed", "Blanks made missing"
    ]
)

display(text_cleanup_summary)

whole_number_check = []

integer_columns = [
    "BedroomsTotal",
    "BathroomsTotalInteger",
    "YearBuilt",
    "DaysOnMarket"
]

for name, df in [("Sold", sold), ("Listings", listings)]:
    for column in integer_columns:
        values = df[column].dropna()

        fractional = values.mod(1).ne(0)

        whole_number_check.append({
            "Dataset": name,
            "Column": column,
            "Values with decimals": int(fractional.sum())
        })

display(pd.DataFrame(whole_number_check))

integer_type_summary = []

for name, df in [("Sold", sold), ("Listings", listings)]:
    for column in integer_columns:
        # Preserve fractional or nonfinite values for review, without rounding.
        values = df[column].dropna()
        eligible = np.isfinite(values).all() and values.mod(1).eq(0).all()
        in_range = values.ge(-(2**63)).all() and values.lt(2**63).all()
        if eligible and in_range:
            df[column] = df[column].astype("Int64")

        integer_type_summary.append({
            "Dataset": name,
            "Column": column,
            "Data type": str(df[column].dtype),
            "Missing values": int(df[column].isna().sum())
        })

display(pd.DataFrame(integer_type_summary))

"""Final summary"""

# Remove exact duplicates after all transformations.
final_duplicate_summary = []

for name in ["Sold", "Listings"]:
    df = sold if name == "Sold" else listings
    rows_before = len(df)

