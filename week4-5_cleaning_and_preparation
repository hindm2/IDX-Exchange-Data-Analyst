"""Convert Datetime"""

date_columns = [
    "CloseDate",
    "PurchaseContractDate",
    "ListingContractDate",
    "ContractStatusChangeDate"
]

date_conversion_summary = []

for name, df in [("Sold", sold), ("Listings", listings)]:
    for column in date_columns:
        original = df[column].astype("string").str.strip()

        # Blank strings are treated as missing dates.
        original = original.replace("", pd.NA)

        # Parse dates; unrecognizable values become NaT.
        converted = pd.to_datetime(
            original,
            format="mixed",
            errors="coerce",
            utc=True
        )

        failed = original.notna() & converted.isna()

        df[column] = converted

        date_conversion_summary.append({
            "Dataset": name,
            "Column": column,
            "Missing before": int(original.isna().sum()),
            "Failed conversions": int(failed.sum()),
            "Missing after": int(converted.isna().sum()),
            "Data type": str(df[column].dtype)
        })

date_conversion_summary = pd.DataFrame(date_conversion_summary)
display(date_conversion_summary)

"""Convert Numeric Columns"""

numeric_columns = [
    "ClosePrice",
    "ListPrice",
    "OriginalListPrice",
    "LivingArea",
    "LotSizeSquareFeet",
