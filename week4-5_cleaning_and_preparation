)

display(numeric_conversion_summary)

"""Checking the order of dates.


 Listing date ≤ Purchase contract date ≤ Closing date
"""

invalid_numeric_summary = []

for name, df in [("Sold", sold), ("Listings", listings)]:
    checks = {
        "invalid_closeprice_flag": df["ClosePrice"] <= 0,
        "invalid_livingarea_flag": df["LivingArea"] <= 0,
        "invalid_dom_flag": df["DaysOnMarket"] < 0,
        "invalid_bedrooms_flag": df["BedroomsTotal"] < 0,
        "invalid_bathrooms_flag": df["BathroomsTotalInteger"] < 0
    }

    for flag, condition in checks.items():
        df[flag] = condition.fillna(False).astype(bool)

        invalid_numeric_summary.append({
            "Dataset": name,
            "Flag": flag,
            "Flagged rows": int(df[flag].sum())
        })

    df["any_invalid_numeric_flag"] = df[list(checks)].any(axis=1)

    invalid_numeric_summary.append({
        "Dataset": name,
        "Flag": "any_invalid_numeric_flag",
        "Flagged rows": int(df["any_invalid_numeric_flag"].sum())
    })

invalid_numeric_summary = pd.DataFrame(invalid_numeric_summary)
display(invalid_numeric_summary)

date_flag_summary = []

for name, df in [("Sold", sold), ("Listings", listings)]:

    listing = df["ListingContractDate"]
    purchase = df["PurchaseContractDate"]
    close = df["CloseDate"]

    df["listing_after_close_flag"] = (
        listing.notna() & close.notna() & (listing > close)
    )

    df["purchase_after_close_flag"] = (
        purchase.notna() & close.notna() & (purchase > close)
    )

    # Also check whether the listing date follows the purchase contract.
    listing_after_purchase = (
        listing.notna() & purchase.notna() & (listing > purchase)
    )

    # True if any available pair violates the expected order.
    df["negative_timeline_flag"] = (
        df["listing_after_close_flag"]
        | df["purchase_after_close_flag"]
        | listing_after_purchase
    )

    for flag in [
        "listing_after_close_flag",
        "purchase_after_close_flag",
        "negative_timeline_flag"
    ]:
        date_flag_summary.append({
            "Dataset": name,
            "Flag": flag,
            "Flagged rows": int(df[flag].sum())
        })

date_flag_summary = pd.DataFrame(date_flag_summary)
display(date_flag_summary)

"""Checked geographic data

Missing latitude or longitude.
Coordinates equal to zero.
Positive longitude.
Impossible coordinates.
Coordinates outside an approximate California bounding box.
"""

geo_summary = []

for name, df in [("Sold", sold), ("Listings", listings)]:
    lat = df["Latitude"]
    lon = df["Longitude"]
    present = lat.notna() & lon.notna()

    df["geo_missing_flag"] = lat.isna() | lon.isna()

    df["geo_zero_flag"] = (
        lat.eq(0) | lon.eq(0)
    ).fillna(False)

    df["geo_positive_lon_flag"] = lon.gt(0).fillna(False)

    df["geo_impossible_flag"] = (
        lat.abs().gt(90) | lon.abs().gt(180)
    ).fillna(False)

    # Approximate bounding box: a screening check, not a state-border test.
    within_ca_box = (
        lat.between(32.5, 42.1)
        & lon.between(-124.5, -114.1)
    ).fillna(False)

    df["geo_outside_ca_box_flag"] = present & ~within_ca_box

    # Combine coordinate-quality issues; count each record once.
    df["geo_coordinate_issue_flag"] = df[[
        "geo_missing_flag",
        "geo_zero_flag",
        "geo_positive_lon_flag",
        "geo_impossible_flag"
    ]].any(axis=1)

    flags = [
        "geo_missing_flag",
        "geo_zero_flag",
        "geo_positive_lon_flag",
        "geo_impossible_flag",
        "geo_outside_ca_box_flag",
        "geo_coordinate_issue_flag"
    ]

    for flag in flags:
        df[flag] = df[flag].astype(bool)

        geo_summary.append({
            "Dataset": name,
            "Flag": flag,
            "Flagged rows": int(df[flag].sum()),
            "Percent": round(100 * df[flag].mean(), 2)
        })

geo_summary = pd.DataFrame(geo_summary)
display(geo_summary)

duplicate_column_summary = []

for column in listings.columns:
    if column.endswith(".1"):
        original_column = column[:-2]

        if original_column in listings.columns:
            original = listings[original_column]
            duplicate = listings[column]

            # Compare the original, unconverted CSV values.
            raw_pair = pd.read_csv(
                "/content/combined_listings_with_rates.csv",
                usecols=["PropertyType", original_column, column],
